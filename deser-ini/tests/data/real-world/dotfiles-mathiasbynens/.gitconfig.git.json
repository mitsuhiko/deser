{
  "git": {
    "entries": [
      ["alias", null, "l", "log --pretty=oneline -n 20 --graph --abbrev-commit"],
      ["alias", null, "s", "status -s"],
      ["alias", null, "d", "!git diff-index --quiet HEAD -- || clear; git --no-pager diff --patch-with-stat"],
      ["alias", null, "di", "!d() { git diff --patch-with-stat HEAD~$1; }; git diff-index --quiet HEAD -- || clear; d"],
      ["alias", null, "p", "pull --recurse-submodules"],
      ["alias", null, "c", "clone --recursive"],
      ["alias", null, "ca", "!git add ':(exclude,attr:builtin_objectmode=160000)' && git commit -av"],
      ["alias", null, "go", "!f() { git checkout -b \"$1\" 2> /dev/null || git checkout \"$1\"; }; f"],
      ["alias", null, "tags", "tag -l"],
      ["alias", null, "branches", "branch --all"],
      ["alias", null, "remotes", "remote --verbose"],
      ["alias", null, "aliases", "config --get-regexp alias"],
      ["alias", null, "amend", "commit --amend --reuse-message=HEAD"],
      ["alias", null, "credit", "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"],
      ["alias", null, "reb", "!r() { git rebase -i HEAD~$1; }; r"],
      ["alias", null, "retag", "!r() { git tag -d $1 && git push origin :refs/tags/$1 && git tag $1; }; r"],
      ["alias", null, "fb", "!f() { git branch -a --contains $1; }; f"],
      ["alias", null, "ft", "!f() { git describe --always --contains $1; }; f"],
      ["alias", null, "fc", "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"],
      ["alias", null, "fm", "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"],
      ["alias", null, "dm", "!git branch --merged | grep -v '\\*' | xargs -n 1 git branch -d"],
      ["alias", null, "contributors", "shortlog --summary --numbered"],
      ["alias", null, "whoami", "config user.email"],
      ["apply", null, "whitespace", "fix"],
      ["branch", null, "sort", "-committerdate"],
      ["core", null, "excludesfile", "~/.gitignore"],
      ["core", null, "attributesfile", "~/.gitattributes"],
      ["core", null, "whitespace", "space-before-tab,-indent-with-non-tab,trailing-space"],
      ["core", null, "trustctime", "false"],
      ["core", null, "precomposeunicode", "false"],
      ["core", null, "untrackedcache", "true"],
      ["color", null, "ui", "auto"],
      ["color", "branch", "current", "yellow reverse"],
      ["color", "branch", "local", "yellow"],
      ["color", "branch", "remote", "green"],
      ["color", "diff", "meta", "yellow bold"],
      ["color", "diff", "frag", "magenta bold"],
      ["color", "diff", "old", "red"],
      ["color", "diff", "new", "green"],
      ["color", "status", "added", "yellow"],
      ["color", "status", "changed", "green"],
      ["color", "status", "untracked", "cyan"],
      ["commit", null, "gpgsign", "true"],
      ["diff", null, "renames", "copies"],
      ["diff", "bin", "textconv", "hexdump -v -C"],
      ["help", null, "autocorrect", "1"],
      ["merge", null, "log", "true"],
      ["push", null, "default", "simple"],
      ["push", null, "followtags", "true"],
      ["url", "git@github.com:", "insteadof", "gh:"],
      ["url", "git@github.com:", "pushinsteadof", "github:"],
      ["url", "git@github.com:", "pushinsteadof", "git://github.com/"],
      ["url", "git://github.com/", "insteadof", "github:"],
      ["url", "git@gist.github.com:", "insteadof", "gst:"],
      ["url", "git@gist.github.com:", "pushinsteadof", "gist:"],
      ["url", "git@gist.github.com:", "pushinsteadof", "git://gist.github.com/"],
      ["url", "git://gist.github.com/", "insteadof", "gist:"],
      ["init", null, "defaultbranch", "main"]
    ]
  }
}
