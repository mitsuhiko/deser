{
  "inih": {
    "default": {
      "events": [
        ["section", 2, "s1"],
        ["value", 3, "s1", "one", "1"],
        ["value", 4, "s1", "one", "[s2]"],
        ["value", 5, "s1", "one", "two = 2"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "events": [
        ["section", 2, "s1"],
        ["value", 3, "s1", "one", "1"],
        ["section", 4, "s2"],
        ["value", 5, "s2", "two", "2"]
      ],
      "error_line": null
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "sections": [
        "s1",
        "s2"
      ],
      "entries": [
        ["s1", "one", "1"],
        ["s2", "two", "2"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "error": {
        "message": "syntax error, unexpected END_OF_LINE, expecting '='",
        "line": 3
      }
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
