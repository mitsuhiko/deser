{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "SECT"],
        ["value", 3, "SECT", "KEY2", "VAL2"]
      ],
      "error_line": 2
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "events": [
        ["section", 1, "SECT"],
        ["value", 2, "SECT", "KEY1", null],
        ["value", 3, "SECT", "KEY2", "VAL2"]
      ],
      "error_line": null
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "ParsingError",
        "line": 2
      }
    },
    "lenient": {
      "error": {
        "type": "MultilineContinuationError",
        "line": 3
      }
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["SECT", "KEY2"], "VAL2"]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
