{
  "inih": {
    "default": {
      "events": [
        ["section", 2, "section"],
        ["value", 3, "section", "key", "value"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "sections": [
        "section"
      ],
      "entries": [
        ["section", "key", "value"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "error": {
        "message": "syntax error, unexpected END_OF_LINE, expecting '='",
        "line": 3
      }
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
