{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "Foo"],
        ["value", 2, "Foo", "", "=val-without-opt-name"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "ParsingError",
        "line": 2
      }
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["Foo", ":"], "val-without-opt-name"]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
