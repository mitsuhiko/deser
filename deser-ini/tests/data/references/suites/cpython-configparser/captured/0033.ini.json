{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "common"],
        ["value", 2, "common", "option", "value"],
        ["value", 3, "common", "Option", "Value"],
        ["section", 5, "Common"],
        ["value", 6, "Common", "option", "a better ${common:option}"],
        ["value", 7, "Common", "Option", "A Better ${common:Option}"],
        ["section", 9, "random"],
        ["value", 10, "random", "foo", "${common:option} redefined"],
        ["value", 11, "random", "Foo", "${Common:Option} Redefined"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "sections": [
        "common",
        "Common",
        "random"
      ],
      "entries": [
        ["common", "option", "value"],
        ["common", "Option", "Value"],
        ["Common", "option", "a better ${common:option}"],
        ["Common", "Option", "A Better ${common:Option}"],
        ["random", "foo", "${common:option} redefined"],
        ["random", "Foo", "${Common:Option} Redefined"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["common", "option"], "value"],
        [["common", "Option"], "Value"],
        [["Common", "option"], "a better ${common:option}"],
        [["Common", "Option"], "A Better ${common:Option}"],
        [["random", "foo"], "${common:option} redefined"],
        [["random", "Foo"], "${Common:Option} Redefined"]
      ]
    },
    "normal": {
      "entries": [
        [["common", "option"], "value"],
        [["common", "Option"], "Value"],
        [["Common", "option"], "a better "],
        [["Common", "Option"], "A Better "],
        [["random", "foo"], " redefined"],
        [["random", "Foo"], " Redefined"]
      ]
    }
  }
}
