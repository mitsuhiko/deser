{
  "inih": {
    "default": {
      "events": [],
      "error_line": 1
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "MissingSectionHeaderError",
        "line": 1
      }
    },
    "lenient": {
      "sections": [
        null
      ],
      "entries": [
        [null, "[badbadbad", "bad"]
      ]
    }
  },
  "php": {
    "raw": {
      "error": {
        "message": "syntax error, unexpected end of file, expecting ']'",
        "line": 1
      }
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
