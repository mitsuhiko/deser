{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "Duplicate Options Here"],
        ["value", 2, "Duplicate Options Here", "option", "= with a value"]
      ],
      "error_line": 3
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "events": [
        ["section", 1, "Duplicate Options Here"],
        ["value", 2, "Duplicate Options Here", "option", "= with a value"],
        ["value", 3, "Duplicate Options Here", "option $ with another value", null]
      ],
      "error_line": null
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "ParsingError",
        "line": 3
      }
    },
    "lenient": {
      "sections": [
        "Duplicate Options Here"
      ],
      "entries": [
        ["Duplicate Options Here", "option", "= with a value"],
        ["Duplicate Options Here", "option $ with another value", null]
      ]
    }
  },
  "php": {
    "raw": {
      "error": {
        "message": "syntax error, unexpected '$'",
        "line": 3
      }
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
