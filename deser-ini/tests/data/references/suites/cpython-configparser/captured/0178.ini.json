{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "And Now For Something"],
        ["value", 2, "And Now For Something", "completely different", "True"],
        ["section", 3, "And Now For Something"],
        ["value", 4, "And Now For Something", "the larch", "1"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "DuplicateSectionError",
        "line": 3
      }
    },
    "lenient": {
      "sections": [
        "And Now For Something"
      ],
      "entries": [
        ["And Now For Something", "completely different", "True"],
        ["And Now For Something", "the larch", "1"]
      ]
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["And Now For Something"], []]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
