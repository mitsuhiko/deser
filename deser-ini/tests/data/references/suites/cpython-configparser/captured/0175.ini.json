{
  "inih": {
    "default": {
      "events": [
        ["value", 2, "", "a", "1"],
        ["value", 3, "", "a", "b = 2"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "events": [
        ["value", 2, "", "a", "1"],
        ["value", 3, "", "b", "2"]
