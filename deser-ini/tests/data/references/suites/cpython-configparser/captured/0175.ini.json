        "line": 2
      }
    },
    "lenient": {
      "sections": [
        null
      ],
      "entries": [
        [null, "a", "1"],
        [null, "b", "2"]
      ]
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["a"], "1"],
        [["b"], "2"]
      ]
