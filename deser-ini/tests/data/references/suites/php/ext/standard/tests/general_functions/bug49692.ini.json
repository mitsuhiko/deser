{
  "inih": {
    "default": {
      "events": [
        ["section", 2, "sitemap"],
        ["value", 3, "sitemap", "/home", "default:index"],
        ["value", 4, "sitemap", "/info", "default:info"]
      ],
      "error_line": 1
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "events": [
        ["value", 1, "", "//my.ini file", null],
        ["section", 2, "sitemap"],
        ["value", 3, "sitemap", "/home", "default:index"],
        ["value", 4, "sitemap", "/info", "default:info"]
      ],
      "error_line": null
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "MissingSectionHeaderError",
        "line": 1
      }
    },
    "lenient": {
      "sections": [
        null,
        "sitemap"
      ],
      "entries": [
        [null, "//my.ini file", null],
        ["sitemap", "/home", "default:index"],
        ["sitemap", "/info", "default:info"]
      ]
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["sitemap", "/home"], "default:index"],
        [["sitemap", "/info"], "default:info"]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
