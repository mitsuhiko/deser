{
  "inih": {
    "default": {
      "events": [],
      "error_line": 5
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "events": [
        ["value", 8, "", "name", null]
      ],
      "error_line": 5
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "MissingSectionHeaderError",
        "line": 5
      }
    },
    "lenient": {
      "sections": [
        null
      ],
      "entries": [
        [null, "[broken", null],
        [null, "name", null]
      ]
    }
  },
  "php": {
    "raw": {
      "error": {
        "message": "syntax error, unexpected end of file, expecting ']'",
        "line": 5
      }
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
