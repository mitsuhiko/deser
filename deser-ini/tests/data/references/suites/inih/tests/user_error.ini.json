{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "section"],
        ["value", 2, "section", "a", "b"],
        ["value", 3, "section", "user", "parse_error"],
        ["value", 4, "section", "c", "d"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "sections": [
        "section"
      ],
      "entries": [
        ["section", "a", "b"],
        ["section", "user", "parse_error"],
        ["section", "c", "d"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["section", "a"], "b"],
        [["section", "user"], "parse_error"],
        [["section", "c"], "d"]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
