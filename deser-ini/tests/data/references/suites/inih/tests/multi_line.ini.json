        ["value", 16, "section3", "foo", "bar"]
      ],
      "error_line": 4
    },
    "no_inline_comments": {
      "events": [
        ["section", 1, "section1"],
        ["value", 2, "section1", "single1", "abc"],
        ["value", 3, "section1", "multi", "this is a"],
        ["value", 4, "section1", "multi", "multi-line value"],
        ["value", 5, "section1", "single2", "xyz"],
        ["section", 6, "section2"],
        ["value", 7, "section2", "multi", "a"],
        ["value", 8, "section2", "multi", "b"],
        ["value", 9, "section2", "multi", "c"],
        ["section", 10, "section3"],
        ["value", 11, "section3", "single", "ghi"],
        ["value", 12, "section3", "multi", "the quick"],
        ["value", 13, "section3", "multi", "brown fox"],
        ["value", 14, "section3", "name", "bob smith  ; comment line 1"],
