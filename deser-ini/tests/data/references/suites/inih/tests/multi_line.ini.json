  "configparser": {
    "default": {
      "sections": [
        "section1",
        "section2",
        "section3"
      ],
      "entries": [
        ["section1", "single1", "abc"],
        ["section1", "multi", "this is a\nmulti-line value"],
        ["section1", "single2", "xyz"],
        ["section2", "multi", "a\nb\nc"],
        ["section3", "single", "ghi"],
        ["section3", "multi", "the quick\nbrown fox"],
