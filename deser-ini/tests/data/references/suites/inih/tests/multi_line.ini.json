        ["section3", "foo", "bar ;c1\nHi World ;c2"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["section1", "single1"], "abc"],
        [["section1", "multi"], "this is a"],
        [["section1", "single2"], "xyz"],
        [["section2", "multi"], "a"],
        [["section3", "name"], "bob smith"],
