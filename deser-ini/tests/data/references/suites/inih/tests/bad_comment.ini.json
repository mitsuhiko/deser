{
  "inih": {
    "default": {
      "events": [],
      "error_line": 1
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "same_as": "default"
    },
    "allow_no_value": {
      "events": [
        ["value", 1, "", "This is an error", null]
      ],
      "error_line": null
    }
  },
  "configparser": {
    "default": {
      "error": {
        "type": "MissingSectionHeaderError",
        "line": 1
      }
    },
    "lenient": {
      "sections": [
        null
      ],
      "entries": [
        [null, "This is an error", null]
      ]
    }
  },
  "php": {
    "raw": {
      "entries": []
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
