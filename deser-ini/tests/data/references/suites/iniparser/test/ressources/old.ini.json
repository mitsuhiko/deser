{
  "inih": {
    "default": {
      "events": [
        ["section", 1, "section"],
        ["value", 2, "section", "key_01", "hello world"],
        ["value", 4, "section", "key1", "321abc"]
      ],
      "error_line": null
    },
    "no_multiline": {
      "same_as": "default"
    },
    "no_inline_comments": {
      "events": [
        ["section", 1, "section"],
        ["value", 2, "section", "key_01", "hello world ;test ini"],
        ["value", 4, "section", "key1", "321abc"]
      ],
      "error_line": null
    },
    "allow_no_value": {
      "same_as": "default"
    }
  },
  "configparser": {
    "default": {
      "sections": [
        "section"
      ],
      "entries": [
        ["section", "key_01", "hello world ;test ini"],
        ["section", "key1", "321abc"]
      ]
    },
    "lenient": {
      "same_as": "default"
    }
  },
  "php": {
    "raw": {
      "entries": [
        [["section", "key_01"], "hello world"],
        [["section", "key1"], "321abc"]
      ]
    },
    "normal": {
      "same_as": "raw"
    }
  }
}
