{
  "tests": [
    "ConfigParserTestCaseExtendedInterpolation.test_extended_interpolation"
  ],
  "parser": "ConfigParser",
  "options": {
    "allow_no_value": false,
    "allow_unnamed_section": false,
    "comment_prefixes": [";", "#"],
    "default_section": "common",
    "defaults": null,
    "delimiters": ["=", ":"],
    "empty_lines_in_values": true,
    "inline_comment_prefixes": [";", "#"],
    "strict": true
  },
  "result": {
    "sections": [
      ["common", [["favourite Beatle", "Paul"], ["favourite color", "green"]]],
      ["tom", [["favourite band", "${favourite color} day"], ["favourite pope", "John ${favourite Beatle} II"], ["sequel", "${favourite pope}I"]]],
      ["ambv", [["favourite Beatle", "George"], ["son of Edward VII", "${favourite Beatle} V"], ["son of George V", "${son of Edward VII}I"]]],
      ["stanley", [["favourite Beatle", "${ambv:favourite Beatle}"], ["favourite pope", "${tom:favourite pope}"], ["favourite color", "black"], ["favourite state of mind", "paranoid"], ["favourite movie", "soylent ${common:favourite color}"], ["favourite song", "${favourite color} sabbath - ${favourite state of mind}"]]]
    ]
  }
}
