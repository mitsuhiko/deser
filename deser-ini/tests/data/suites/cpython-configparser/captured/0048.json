{
  "tests": [
    "ConfigParserTestCaseExtendedInterpolation.test_strange_options"
  ],
  "parser": "ConfigParser",
  "options": {
    "allow_no_value": false,
    "allow_unnamed_section": false,
    "comment_prefixes": [";", "#"],
    "default_section": "common",
    "defaults": null,
    "delimiters": ["=", ":"],
    "empty_lines_in_values": true,
    "inline_comment_prefixes": [";", "#"],
    "strict": true
  },
  "result": {
    "sections": [
      ["dollars", [["$var", "$$value"], ["$var2", "${$var}"], ["${sick}", "cannot interpolate me"]]],
      ["interpolated", [["$other", "${dollars:$var}"], ["$trying", "${dollars:${sick}}"]]]
    ]
  }
}
