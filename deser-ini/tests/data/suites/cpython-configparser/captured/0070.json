{
  "tests": [
    "ConfigParserTestCaseNoValue.test_write"
  ],
  "parser": "ConfigParser",
  "options": {
    "allow_no_value": true,
    "allow_unnamed_section": false,
    "comment_prefixes": [";", "#"],
    "default_section": "DEFAULT",
    "defaults": null,
    "delimiters": ["=", ":"],
    "empty_lines_in_values": true,
    "inline_comment_prefixes": [";", "#"],
    "strict": false
  },
  "result": {
    "sections": [
      ["DEFAULT", [["foo", "another very\nlong line"]]],
      ["Long Line", [["foo", "this line is much, much longer than my editor\nlikes it."]]],
      ["Long Line - With Comments!", [["test", "we\nalso\ncomments\nmultiline"]]],
      ["Valueless", [["option-without-value", null]]]
    ]
  }
}
