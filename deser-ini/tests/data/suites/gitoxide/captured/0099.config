
        [user]
            email = code@eddie.sh
        [core]
            autocrlf = input
        [push]
            default = simple
        [commit]
            gpgsign = true
        [gpg]
            program = gpg
        [url "ssh://git@github.com/"]
            insteadOf = "github://"
        [url "ssh://git@git.eddie.sh/edward/"]
            insteadOf = "gitea://"
        [pull]
            ff = only
        [init]
            defaultBranch = master
    