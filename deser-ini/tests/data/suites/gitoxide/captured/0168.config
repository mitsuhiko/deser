 ; root beginning
# root pre base
[section]
    value = base # base comment
; root post base    
[include]
  path = /tmp/.tmpXXXXXX/first-incl
  path = /tmp/.tmpXXXXXX/first-incl ; paths are multi-values
# root past first include
[section]
  value = base-past-first-include
# root before include-if no-nl
[includeIf "gitdir:root/"]
  path = /tmp/.tmpXXXXXX/incl-if
[section]
  value = base-past-includeIf
[include]
  path = /tmp/.tmpXXXXXX/second-incl
# root past last include
[section]
  value = base-past-second-include 
; root last include